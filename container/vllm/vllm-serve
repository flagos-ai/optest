# vllm-serve — sources the full vendor env then execs vllm's API server.
#
# Profile.d sources the baked LD_LIBRARY_PATH and other vendor env vars
# that are NOT in the image ENV (a plain `docker run python ...` bypasses
# bash and misses them). This launcher bridges that gap: sources once,
# then execs vllm serve, passing all args verbatim.
set -e

# Source the full vendor env from /etc/profile.d (idempotent).
if [ -d /etc/profile.d ]; then
    for f in /etc/profile.d/*.sh; do
        # shellcheck disable=SC1090
        [ -r "$f" ] && . "$f"
    done
fi

exec python -m vllm.entrypoints.openai.api_server "$@"
